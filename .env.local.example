# Copy to .env.local for local development. Never commit the real values.

# Site-wide password gate (see middleware.ts)
APP_PASSWORD=changeme

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Optional: protects /api/cron/sync from being called by anyone but Vercel's
# scheduler. Leave unset locally; Vercel sets this automatically in
# production once you add it as a project environment variable.
CRON_SECRET=

# Optional: only needed to test against real cloud storage locally instead of
# the local-file fallback (data/store.local.json). Vercel injects these
# automatically once you add the Redis (Upstash) integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
